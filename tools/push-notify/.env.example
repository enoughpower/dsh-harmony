# 推送通道: test(默认, 临时异常测试渠道) | huawei(华为AGC, 需手机push token)
SENDER=test
# 临时异常测试渠道昵称(仅 SENDER=test 时)
TEST_NICK=
# 华为 AGC 凭证(仅 SENDER=huawei 时)
PUSH_APP_ID=<AppID>
PUSH_APP_SECRET=<AppSecret>
# dsh-pocket 连接
DSH_BASE=http://127.0.0.1:3081
DSH_PIN=11111111
# 通知图标 216x216 PNG 公网 URL(可选, 默认 App 图标 raw 直链)
TEST_ICON=

# V3 服务账号密钥 JSON 路径(HarmonyOS NEXT 设备必须 V3+JWT,替换 OAuth 方式)
PUSH_KEY_FILE=
